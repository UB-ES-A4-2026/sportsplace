# Copiar este archivo a .env en la raíz. Nunca subir .env a Git.
# Puertos disponibles en tu ordenador; los puertos internos son fijos.
WEB_PORT=5173
API_PORT=3000

# Windows/macOS: mantener 1000. Linux: poner los valores de id -u e id -g.
LOCAL_UID=1000
LOCAL_GID=1000

# Opcional en TR-02: URL y clave PUBLICABLE del proyecto Supabase compartido.
# El arranque y /api/health funcionan con estos valores vacíos.
# Estas variables preparan la configuración; aún no se consulta Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# No poner aquí contraseñas de la base de datos, claves secret ni service_role.
# Compose expone estos dos valores al frontend como VITE_SUPABASE_*.
