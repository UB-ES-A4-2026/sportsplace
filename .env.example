# Copiar este archivo a .env en la raíz. Nunca subir .env a Git.
# Puertos disponibles en tu ordenador; los puertos internos son fijos.
WEB_PORT=5173
API_PORT=3000

# Windows/macOS: mantener 1000. Linux: poner los valores de id -u e id -g.
LOCAL_UID=1000
LOCAL_GID=1000

# Opcional en TR-02: URL y clave PUBLICABLE del proyecto Supabase compartido.
# El arranque y /api/health funcionan con estos valores vacíos.
# Estas variables preparan el cliente web; su integración funcional está pendiente.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# No poner contraseñas, claves secret ni service_role en estas dos variables.
# Compose expone estos dos valores al frontend como VITE_SUPABASE_*.

# TR-03: conexión PostgreSQL privada, solo backend y herramientas de migración.
# Copiar la URI de Supabase Connect > Session pooler y poner la contraseña local.
# Nunca usar VITE_DATABASE_URL ni subir este valor real a Git/chat/capturas.
DATABASE_URL=

# Opcional: URI de un usuario con permiso para migrar si DATABASE_URL no lo tiene.
MIGRATION_DATABASE_URL=

# Opcional: certificado CA descargado de Database Settings > SSL Configuration.
# Guardarlo en backend/.certs/supabase-ca.crt; en Docker usar la ruta indicada.
# DATABASE_SSL_CA_FILE=/app/.certs/supabase-ca.crt
DATABASE_SSL_CA_FILE=
